{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "Represents a to-do item with priority, categories, due date reminders, and collaboration sharing.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the task"
        },
        "userId": {
          "type": "string",
          "description": "User ID of the task creator and owner"
        },
        "title": {
          "type": "string",
          "description": "Title of the task"
        },
        "description": {
          "type": "string",
          "description": "Detailed description or notes for the task"
        },
        "category": {
          "type": "string",
          "description": "Category or tag name (e.g., Work, Personal, Health, Shopping)"
        },
        "priority": {
          "type": "string",
          "description": "Priority level: LOW, MEDIUM, HIGH, URGENT",
          "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"]
        },
        "dueDate": {
          "type": "string",
          "format": "date-time",
          "description": "Due timestamp when the task is scheduled or due"
        },
        "reminderMinutesBefore": {
          "type": "integer",
          "description": "Minutes before due date to alert user"
        },
        "completed": {
          "type": "boolean",
          "description": "Completion status of the task"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the task was marked as completed"
        },
        "sharedWithUids": {
          "type": "array",
          "description": "List of collaborator user IDs who have shared access to this task"
        },
        "sharedWithEmails": {
          "type": "array",
          "description": "List of collaborator emails display tags"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp; clients must provide FieldValue.serverTimestamp()"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp; clients must provide FieldValue.serverTimestamp()"
        }
      },
      "required": [
        "id",
        "userId",
        "title",
        "category",
        "priority",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account public profile for collaboration discovery",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user"
        },
        "photoUrl": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile update timestamp"
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "User custom category tag",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the category"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID of the category"
        },
        "name": {
          "type": "string",
          "description": "Category name"
        },
        "colorHex": {
          "type": "string",
          "description": "Hex color code for visual badge"
        },
        "iconName": {
          "type": "string",
          "description": "Material symbol name or key"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "name", "colorHex", "iconName", "createdAt"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Collection of tasks owned by users or shared with collaborators"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User account profiles"
    },
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "User defined categories"
    }
  }
}
